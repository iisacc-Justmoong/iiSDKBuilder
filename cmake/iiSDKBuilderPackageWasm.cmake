cmake_minimum_required(VERSION 3.31)
if(NOT DEFINED INPUT OR NOT EXISTS "${INPUT}" OR NOT DEFINED MAIN_WASM OR NOT EXISTS "${MAIN_WASM}" OR NOT DEFINED DESTINATION)
    message(FATAL_ERROR "WebAssembly packaging needs a loader, main module and destination")
endif()
get_filename_component(_input_name "${INPUT}" NAME)
get_filename_component(_input_dir "${INPUT}" DIRECTORY)
get_filename_component(_stem "${INPUT}" NAME_WE)
get_filename_component(_extension "${INPUT}" EXT)
if(NOT _extension MATCHES "^\\.(js|html)$")
    message(FATAL_ERROR "WebAssembly app packaging requires an Emscripten JS or HTML loader")
endif()
if(_extension STREQUAL ".html")
    set(_loader "${_input_dir}/${_stem}.js")
    if(NOT EXISTS "${_loader}")
        message(FATAL_ERROR "The HTML entry point has no matching JS loader")
    endif()
else()
    set(_loader "${INPUT}")
endif()
list(LENGTH SIDE_FILES _files_count)
list(LENGTH SIDE_NAMES _names_count)
if(NOT _files_count EQUAL _names_count)
    message(FATAL_ERROR "WebAssembly dependency file/name lists disagree")
endif()
set(_staging "${DESTINATION}.staging")
set(_previous "${DESTINATION}.previous")
if(EXISTS "${_staging}" OR EXISTS "${_previous}")
    message(FATAL_ERROR "A previous package transaction needs inspection")
endif()
if(EXISTS "${DESTINATION}" AND NOT EXISTS "${DESTINATION}/.iisdkbuilder-package")
    message(FATAL_ERROR "Refusing to replace an unowned package")
endif()
file(MAKE_DIRECTORY "${_staging}")
file(WRITE "${_staging}/.iisdkbuilder-package" "iiSDKBuilder WebAssembly application\n")
file(COPY "${INPUT}" "${MAIN_WASM}" DESTINATION "${_staging}")
if(NOT _loader STREQUAL INPUT)
    file(COPY "${_loader}" DESTINATION "${_staging}")
endif()
file(READ "${_loader}" _loader_text LIMIT 67108864)
foreach(_suffix IN ITEMS ".worker.js" ".data")
    set(_name "${_stem}${_suffix}")
    string(FIND "${_loader_text}" "${_name}" _referenced)
    if(NOT _referenced EQUAL -1)
        if(NOT EXISTS "${_input_dir}/${_name}")
            message(FATAL_ERROR "Referenced WebAssembly loader asset is missing: ${_name}")
        endif()
        file(COPY "${_input_dir}/${_name}" DESTINATION "${_staging}")
    endif()
endforeach()
if(_files_count GREATER 0)
    math(EXPR _last "${_files_count}-1")
    foreach(_i RANGE 0 ${_last})
        list(GET SIDE_FILES ${_i} _source)
        list(GET SIDE_NAMES ${_i} _name)
        if(NOT EXISTS "${_source}" OR IS_ABSOLUTE "${_name}" OR _name MATCHES "(^|/)\\.\\.?(/|$)" OR _name MATCHES "\\\\")
            message(FATAL_ERROR "Invalid WebAssembly side module: ${_name}")
        endif()
        get_filename_component(_directory "${_staging}/${_name}" DIRECTORY)
        file(MAKE_DIRECTORY "${_directory}")
        if(EXISTS "${_staging}/${_name}")
            message(FATAL_ERROR "WebAssembly output collision: ${_name}")
        endif()
        file(COPY_FILE "${_source}" "${_staging}/${_name}")
    endforeach()
endif()
if(EXISTS "${DESTINATION}")
    file(RENAME "${DESTINATION}" "${_previous}" RESULT _result)
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "Cannot preserve previous WebAssembly package: ${_result}")
    endif()
endif()
file(RENAME "${_staging}" "${DESTINATION}" RESULT _result)
if(NOT _result STREQUAL "0")
    if(EXISTS "${_previous}")
        file(RENAME "${_previous}" "${DESTINATION}")
    endif()
    message(FATAL_ERROR "Cannot publish WebAssembly package: ${_result}")
endif()
if(EXISTS "${_previous}/.iisdkbuilder-package")
    file(REMOVE_RECURSE "${_previous}")
endif()
