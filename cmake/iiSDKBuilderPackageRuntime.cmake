# Embedded by iiSDKBuilder and invoked for one native executable after linking.
cmake_minimum_required(VERSION 3.31)
if(NOT DEFINED INPUT OR NOT EXISTS "${INPUT}" OR NOT DEFINED DESTINATION OR NOT DEFINED PLATFORM)
    message(FATAL_ERROR "A built executable, destination and platform are required")
endif()
if(NOT PLATFORM MATCHES "^(macos|windows|linux)$")
    message(FATAL_ERROR "No native runtime packager for ${PLATFORM}")
endif()
set(_staging "${DESTINATION}.staging")
set(_previous "${DESTINATION}.previous")
if(EXISTS "${_staging}" OR EXISTS "${_previous}")
    message(FATAL_ERROR "A previous package transaction needs inspection: ${DESTINATION}")
endif()
if(EXISTS "${DESTINATION}" AND NOT EXISTS "${DESTINATION}/.iisdkbuilder-package")
    message(FATAL_ERROR "Refusing to replace a directory not owned by iiSDKBuilder: ${DESTINATION}")
endif()
# App-owned frameworks are searched as potential explicit plugins, but only
# the selected dependency closure is copied into the replacement bundle.
if(PLATFORM STREQUAL "macos" AND INPUT MATCHES "^(.*\\.app)/Contents/MacOS/[^/]+$")
    list(APPEND SEARCH_DIRS "${CMAKE_MATCH_1}/Contents/Frameworks")
endif()
# Explicit plugins are included only by app declaration, since dlopen-style
# calls are not represented in an executable's load commands.
set(_modules)
foreach(_name IN LISTS MODULE_NAMES)
    string(FIND "${_name}" "/" _slash)
    string(FIND "${_name}" "\\" _backslash)
    if(_name STREQUAL "" OR NOT _slash EQUAL -1 OR NOT _backslash EQUAL -1 OR _name STREQUAL "." OR _name STREQUAL "..")
        message(FATAL_ERROR "Runtime module must be a file name: ${_name}")
    endif()
    set(_found)
    foreach(_dir IN LISTS SEARCH_DIRS)
        if(EXISTS "${_dir}/${_name}" AND NOT IS_DIRECTORY "${_dir}/${_name}")
            file(REAL_PATH "${_dir}/${_name}" _real)
            list(APPEND _found "${_real}")
            set(_found_path "${_dir}/${_name}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _found)
    list(LENGTH _found _count)
    if(NOT _count EQUAL 1)
        message(FATAL_ERROR "Runtime module ${_name} must resolve to exactly one file; found ${_count}")
    endif()
    list(APPEND _modules "${_found_path}")
endforeach()
# Resolve before creating or modifying the package. Cross-host inspection is
# rejected by the caller because CMake uses native platform inspection tools.
set(_module_arguments)
if(_modules)
    list(APPEND _module_arguments MODULES ${_modules})
endif()
set(_extra_libraries)
while(TRUE)
    set(_library_arguments)
    if(_extra_libraries)
        list(APPEND _library_arguments LIBRARIES ${_extra_libraries})
    endif()
    file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${INPUT}" ${_module_arguments} ${_library_arguments}
        DIRECTORIES ${SEARCH_DIRS}
        PRE_EXCLUDE_REGEXES "^[Aa][Pp][Ii]-[Mm][Ss]-" "^[Ee][Xx][Tt]-[Mm][Ss]-" "^linux-vdso"
        RESOLVED_DEPENDENCIES_VAR _resolved
        UNRESOLVED_DEPENDENCIES_VAR _unresolved
        CONFLICTING_DEPENDENCIES_PREFIX _conflicts)
    if(_conflicts_FILENAMES)
        message(FATAL_ERROR "Ambiguous runtime dependencies: ${_conflicts_FILENAMES}")
    endif()
    set(_added FALSE)
    foreach(_missing IN LISTS _unresolved)
        # CMake's Mach-O scanner does not search DIRECTORIES for an explicit
        # plugin's @rpath. Resolve an exact name against selected prefixes and
        # scan that library as another root; do not rewrite arbitrary paths.
        if(NOT PLATFORM STREQUAL "macos" OR NOT _missing MATCHES "^@rpath/([^/]+)$")
            message(FATAL_ERROR "Unresolved runtime dependency: ${_missing}")
        endif()
        set(_name "${CMAKE_MATCH_1}")
        set(_matches)
        foreach(_dir IN LISTS SEARCH_DIRS)
            if(EXISTS "${_dir}/${_name}" AND NOT IS_DIRECTORY "${_dir}/${_name}")
                file(REAL_PATH "${_dir}/${_name}" _real)
                list(APPEND _matches "${_real}")
                set(_match "${_dir}/${_name}")
            endif()
        endforeach()
        list(REMOVE_DUPLICATES _matches)
        list(LENGTH _matches _count)
        if(NOT _count EQUAL 1)
            message(FATAL_ERROR "Unresolved or ambiguous runtime dependency: ${_missing}")
        endif()
        if(NOT _match IN_LIST _extra_libraries)
            list(APPEND _extra_libraries "${_match}")
            set(_added TRUE)
        endif()
    endforeach()
    if(NOT _added)
        break()
    endif()
endwhile()
list(APPEND _resolved ${_modules} ${_extra_libraries})
list(REMOVE_DUPLICATES _resolved)
set(_libraries)
set(_names)
foreach(_lib IN LISTS _resolved)
    file(TO_CMAKE_PATH "${_lib}" _normalized)
    string(TOLOWER "${_normalized}" _lower)
    if(PLATFORM STREQUAL "macos" AND _normalized MATCHES "^(/usr/lib/|/System/Library/)")
        continue()
    elseif(PLATFORM STREQUAL "linux")
        get_filename_component(_base "${_normalized}" NAME)
        if(_base MATCHES "^(ld-linux[^/]*|lib(c|m|dl|pthread|rt|resolv|util|nsl)\\.so(\\.[0-9]+)*)$")
            continue()
        endif()
    elseif(PLATFORM STREQUAL "windows")
        if(NOT DEFINED ENV{SystemRoot} OR "$ENV{SystemRoot}" STREQUAL "")
            message(FATAL_ERROR "SystemRoot is required to identify Windows system libraries")
        endif()
        file(TO_CMAKE_PATH "$ENV{SystemRoot}" _windows_root)
        string(TOLOWER "${_windows_root}/" _windows_root)
        string(FIND "${_lower}" "${_windows_root}" _system_index)
        if(_system_index EQUAL 0)
            continue()
        endif()
    endif()
    if(_normalized MATCHES "\\.framework/")
        message(FATAL_ERROR "Non-system frameworks require framework-aware packaging: ${_lib}")
    endif()
    get_filename_component(_name "${_lib}" NAME)
    string(TOLOWER "${_name}" _key)
    if(_key IN_LIST _names)
        message(FATAL_ERROR "Runtime library name collision: ${_name}")
    endif()
    list(APPEND _names "${_key}")
    list(APPEND _libraries "${_lib}")
endforeach()
file(MAKE_DIRECTORY "${_staging}")
file(WRITE "${_staging}/.iisdkbuilder-package" "iiSDKBuilder runtime package\n")
get_filename_component(_input_name "${INPUT}" NAME)
if(PLATFORM STREQUAL "macos" AND INPUT MATCHES "^(.*\\.app)/Contents/MacOS/[^/]+$")
    set(_bundle "${CMAKE_MATCH_1}")
    get_filename_component(_bundle_name "${_bundle}" NAME)
    file(COPY "${_bundle}" DESTINATION "${_staging}")
    set(_executable "${_staging}/${_bundle_name}/Contents/MacOS/${_input_name}")
    set(_libdir "${_staging}/${_bundle_name}/Contents/Frameworks")
    # The copy is owned by this transaction. Recreate its runtime directory
    # so unused libraries from a pre-populated app bundle are not carried over.
    file(REMOVE_RECURSE "${_libdir}")
    set(_exec_relative "@loader_path/../Frameworks")
elseif(PLATFORM STREQUAL "windows")
    set(_libdir "${_staging}/bin")
    file(MAKE_DIRECTORY "${_libdir}")
    file(COPY "${INPUT}" DESTINATION "${_libdir}")
    set(_executable "${_libdir}/${_input_name}")
else()
    file(MAKE_DIRECTORY "${_staging}/bin")
    file(COPY "${INPUT}" DESTINATION "${_staging}/bin")
    set(_executable "${_staging}/bin/${_input_name}")
    set(_libdir "${_staging}/lib")
    set(_exec_relative "@loader_path/../lib")
endif()
file(MAKE_DIRECTORY "${_libdir}")
set(_copies)
foreach(_lib IN LISTS _libraries)
    get_filename_component(_name "${_lib}" NAME)
    set(_copy "${_libdir}/${_name}")
    if(EXISTS "${_copy}")
        file(SHA256 "${_lib}" _source_hash)
        file(SHA256 "${_copy}" _copy_hash)
        if(NOT _source_hash STREQUAL _copy_hash)
            message(FATAL_ERROR "Runtime library conflicts with existing package content: ${_copy}")
        endif()
    else()
        file(COPY_FILE "${_lib}" "${_copy}")
    endif()
    list(APPEND _copies "${_copy}")
endforeach()
if(PLATFORM STREQUAL "macos")
    find_program(_otool otool REQUIRED)
    find_program(_install_name_tool install_name_tool REQUIRED)
    find_program(_codesign codesign REQUIRED)
    foreach(_image IN LISTS _copies ITEMS "${_executable}")
        execute_process(COMMAND "${_otool}" -L "${_image}" OUTPUT_VARIABLE _deps RESULT_VARIABLE _result)
        if(NOT _result EQUAL 0)
            message(FATAL_ERROR "Cannot inspect Mach-O dependencies: ${_image}")
        endif()
        if(_image STREQUAL _executable)
            set(_relative "${_exec_relative}")
        else()
            set(_relative "@loader_path")
            get_filename_component(_image_name "${_image}" NAME)
            execute_process(COMMAND "${_install_name_tool}" -id "@rpath/${_image_name}" "${_image}" RESULT_VARIABLE _result)
            if(NOT _result EQUAL 0)
                message(FATAL_ERROR "Cannot set packaged library identity: ${_image}")
            endif()
        endif()
        string(REPLACE "\n" ";" _lines "${_deps}")
        list(REMOVE_DUPLICATES _lines)
        foreach(_line IN LISTS _lines)
            string(STRIP "${_line}" _line)
            if(NOT _line MATCHES "^(.+) \\(compatibility version ")
                continue()
            endif()
            set(_old "${CMAKE_MATCH_1}")
            if(_old MATCHES "^(/usr/lib/|/System/Library/)")
                continue()
            endif()
            get_filename_component(_name "${_old}" NAME)
            string(TOLOWER "${_name}" _key)
            if(NOT _key IN_LIST _names)
                message(FATAL_ERROR "Unpackaged Mach-O dependency ${_old} in ${_image}")
            endif()
            set(_new "${_relative}/${_name}")
            if(NOT _old STREQUAL _new)
                execute_process(COMMAND "${_install_name_tool}" -change "${_old}" "${_new}" "${_image}" RESULT_VARIABLE _result)
                if(NOT _result EQUAL 0)
                    message(FATAL_ERROR "Cannot relocate ${_old} in ${_image}")
                endif()
            endif()
        endforeach()
        execute_process(COMMAND "${_codesign}" --force --sign - "${_image}" RESULT_VARIABLE _result)
        if(NOT _result EQUAL 0)
            message(FATAL_ERROR "Cannot sign packaged Mach-O: ${_image}")
        endif()
    endforeach()
    if(DEFINED _bundle_name)
        execute_process(COMMAND "${_codesign}" --force --sign - "${_staging}/${_bundle_name}" RESULT_VARIABLE _result)
        if(NOT _result EQUAL 0)
            message(FATAL_ERROR "Cannot sign packaged app bundle")
        endif()
    endif()
elseif(PLATFORM STREQUAL "linux")
    find_program(_patchelf patchelf REQUIRED)
    foreach(_image IN LISTS _copies ITEMS "${_executable}")
        if(_image STREQUAL _executable)
            set(_rpath "$ORIGIN/../lib")
        else()
            set(_rpath "$ORIGIN")
        endif()
        execute_process(COMMAND "${_patchelf}" --set-rpath "${_rpath}" "${_image}" RESULT_VARIABLE _result)
        if(NOT _result EQUAL 0)
            message(FATAL_ERROR "Cannot relocate ELF image: ${_image}")
        endif()
    endforeach()
endif()
if(EXISTS "${DESTINATION}")
    file(RENAME "${DESTINATION}" "${_previous}" RESULT _result)
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "Cannot preserve previous package: ${_result}")
    endif()
endif()
file(RENAME "${_staging}" "${DESTINATION}" RESULT _result)
if(NOT _result STREQUAL "0")
    if(EXISTS "${_previous}")
        file(RENAME "${_previous}" "${DESTINATION}")
    endif()
    message(FATAL_ERROR "Cannot publish package: ${_result}")
endif()
if(EXISTS "${_previous}/.iisdkbuilder-package")
    file(REMOVE_RECURSE "${_previous}")
endif()
