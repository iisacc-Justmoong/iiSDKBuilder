if(NOT PROJECT_ROOT OR NOT TEST_ROOT)
    message(FATAL_ERROR "PROJECT_ROOT and TEST_ROOT are required")
endif()

if(CMAKE_HOST_WIN32)
    set(_clang_name "clang++.exe")
else()
    set(_clang_name "clang++")
endif()
set(_root "${TEST_ROOT}/LLVM with spaces")
file(MAKE_DIRECTORY "${_root}/bin")
set(_clang "${_root}/bin/${_clang_name}")
file(WRITE "${_clang}" "fixture")
file(CHMOD "${_clang}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)

set(ENV{LLVM_ROOT} "${_root}")
unset(IISDK_HLS_CLANG)
unset(IISDK_HLS_CLANG CACHE)
include("${PROJECT_ROOT}/cmake/HlsClang.cmake")
iisdk_builder_find_hls_clang()
if(NOT IISDK_HLS_CLANG STREQUAL _clang)
    message(FATAL_ERROR "LLVM_ROOT was not used: ${IISDK_HLS_CLANG}")
endif()

set(_explicit "${TEST_ROOT}/explicit/${_clang_name}")
unset(IISDK_HLS_CLANG)
set(IISDK_HLS_CLANG "${_explicit}" CACHE FILEPATH "Explicit test compiler" FORCE)
iisdk_builder_find_hls_clang()
if(NOT IISDK_HLS_CLANG STREQUAL _explicit)
    message(FATAL_ERROR "The explicit HLS compiler override was not retained")
endif()
