function(iisdk_builder_find_hls_clang)
    set(_hints "/opt/homebrew/opt/llvm/bin")
    if(DEFINED ENV{LLVM_ROOT} AND NOT "$ENV{LLVM_ROOT}" STREQUAL "")
        list(PREPEND _hints "$ENV{LLVM_ROOT}/bin")
    endif()
    if(WIN32)
        if(DEFINED ENV{ProgramFiles} AND NOT "$ENV{ProgramFiles}" STREQUAL "")
            list(APPEND _hints "$ENV{ProgramFiles}/LLVM/bin")
        endif()
        if(DEFINED ENV{VCINSTALLDIR} AND NOT "$ENV{VCINSTALLDIR}" STREQUAL "")
            list(APPEND _hints "$ENV{VCINSTALLDIR}/Tools/Llvm/bin"
                "$ENV{VCINSTALLDIR}/Tools/Llvm/x64/bin")
        endif()
    endif()
    find_program(IISDK_HLS_CLANG NAMES clang++ HINTS ${_hints} REQUIRED)
    set(IISDK_HLS_CLANG "${IISDK_HLS_CLANG}" PARENT_SCOPE)
endfunction()
