cmake_minimum_required(VERSION 3.31)
foreach(_required IN ITEMS INPUT DESTINATION ANDROID_ABI ANDROID_API ANDROID_NDK ANDROID_SDK MANIFEST)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "Android packaging requires ${_required}")
    endif()
endforeach()
if(NOT EXISTS "${INPUT}" OR NOT EXISTS "${MANIFEST}")
    message(FATAL_ERROR "Android app library and manifest must exist")
endif()
if(NOT ANDROID_API MATCHES "^[0-9]+$" OR ANDROID_API LESS 21)
    message(FATAL_ERROR "Invalid Android API level")
endif()
if(ANDROID_ABI STREQUAL "arm64-v8a")
    set(_triple aarch64-linux-android)
    set(_machine "AArch64")
elseif(ANDROID_ABI STREQUAL "armeabi-v7a")
    set(_triple arm-linux-androideabi)
    set(_machine "ARM")
elseif(ANDROID_ABI STREQUAL "x86_64")
    set(_triple x86_64-linux-android)
    set(_machine "Advanced Micro Devices X86-64")
elseif(ANDROID_ABI STREQUAL "x86")
    set(_triple i686-linux-android)
    set(_machine "Intel 80386")
else()
    message(FATAL_ERROR "Unsupported Android ABI: ${ANDROID_ABI}")
endif()
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    set(_host darwin-x86_64)
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    set(_host linux-x86_64)
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
    set(_host windows-x86_64)
else()
    message(FATAL_ERROR "Unsupported NDK host")
endif()
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
    set(_exe_suffix ".exe")
else()
    set(_exe_suffix "")
endif()
set(_toolroot "${ANDROID_NDK}/toolchains/llvm/prebuilt/${_host}")
find_program(_readelf NAMES llvm-readelf llvm-readobj HINTS "${_toolroot}/bin" NO_DEFAULT_PATH REQUIRED)
set(_sysroot "${_toolroot}/sysroot")
file(GLOB _aapt_candidates "${ANDROID_SDK}/build-tools/*/aapt2${_exe_suffix}")
file(GLOB _align_candidates "${ANDROID_SDK}/build-tools/*/zipalign${_exe_suffix}")
file(GLOB _jar_candidates "${ANDROID_SDK}/platforms/android-*/android.jar")
list(SORT _aapt_candidates COMPARE NATURAL ORDER DESCENDING)
list(SORT _align_candidates COMPARE NATURAL ORDER DESCENDING)
list(SORT _jar_candidates COMPARE NATURAL ORDER DESCENDING)
if(NOT _aapt_candidates OR NOT _align_candidates OR NOT _jar_candidates)
    message(FATAL_ERROR "Android SDK must contain aapt2, zipalign and a platform android.jar")
endif()
list(GET _aapt_candidates 0 _aapt)
list(GET _align_candidates 0 _align)
list(GET _jar_candidates 0 _jar)
set(_staging "${DESTINATION}.staging")
set(_previous "${DESTINATION}.previous")
if(EXISTS "${_staging}" OR EXISTS "${_previous}")
    message(FATAL_ERROR "A previous package transaction needs inspection: ${DESTINATION}")
endif()
if(EXISTS "${DESTINATION}" AND NOT EXISTS "${DESTINATION}/.iisdkbuilder-package")
    message(FATAL_ERROR "Refusing to replace a directory not owned by iiSDKBuilder")
endif()
if(DEFINED DEX AND NOT DEX STREQUAL "")
    if(NOT EXISTS "${DEX}")
        message(FATAL_ERROR "Requested Android classes.dex is missing")
    endif()
    file(SIZE "${DEX}" _dex_size)
    file(READ "${DEX}" _dex_magic LIMIT 8 HEX)
    if(_dex_size LESS 112 OR NOT _dex_magic MATCHES "^6465780a3[0-9]3[0-9]3[0-9]00$")
        message(FATAL_ERROR "Android classes.dex has an invalid DEX header")
    endif()
endif()
list(APPEND SEARCH_DIRS "${_sysroot}/usr/lib/${_triple}")
set(_queue "${INPUT}")
foreach(_module IN LISTS MODULE_NAMES)
    if(NOT _module MATCHES "^lib[^/\\\\]+\\.so$")
        message(FATAL_ERROR "Invalid Android runtime module name: ${_module}")
    endif()
    set(_matches)
    foreach(_dir IN LISTS SEARCH_DIRS)
        if(EXISTS "${_dir}/${_module}")
            file(REAL_PATH "${_dir}/${_module}" _real)
            list(APPEND _matches "${_real}")
            set(_path "${_dir}/${_module}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _matches)
    list(LENGTH _matches _count)
    if(NOT _count EQUAL 1)
        message(FATAL_ERROR "Android runtime module ${_module} is missing or ambiguous")
    endif()
    list(APPEND _queue "${_path}")
endforeach()
set(_seen)
set(_names)
set(_libraries)
while(_queue)
    list(POP_FRONT _queue _library)
    file(REAL_PATH "${_library}" _real)
    if(_real IN_LIST _seen)
        continue()
    endif()
    list(APPEND _seen "${_real}")
    get_filename_component(_name "${_library}" NAME)
    if(NOT _name MATCHES "^lib[^/\\\\]+\\.so$")
        message(FATAL_ERROR "Android APK libraries must use lib*.so names: ${_name}")
    endif()
    if(_name IN_LIST _names)
        message(FATAL_ERROR "Android library name collision: ${_name}")
    endif()
    list(APPEND _names "${_name}")
    list(APPEND _libraries "${_library}")
    execute_process(COMMAND "${_readelf}" -h -d "${_library}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _elf ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0 OR NOT _elf MATCHES "Machine:[ \t]*${_machine}" OR NOT _elf MATCHES "Type:[ \t]*DYN")
        message(FATAL_ERROR "Invalid Android ${ANDROID_ABI} shared ELF ${_library}: ${_error}")
    endif()
    string(REGEX MATCHALL "\\(NEEDED\\)[^\n]*\\[[^]]+\\]" _needed_lines "${_elf}")
    foreach(_line IN LISTS _needed_lines)
        string(REGEX REPLACE ".*\\[([^]]+)\\].*" "\\1" _needed "${_line}")
        if(NOT _needed MATCHES "^lib[^/\\\\]+\\.so$")
            message(FATAL_ERROR "Invalid Android DT_NEEDED: ${_needed}")
        endif()
        if(NOT _needed STREQUAL "libc++_shared.so" AND
           (EXISTS "${_sysroot}/usr/lib/${_triple}/${ANDROID_API}/${_needed}" OR
            EXISTS "${_sysroot}/usr/lib/${_triple}/${_needed}"))
            continue()
        endif()
        set(_matches)
        foreach(_dir IN LISTS SEARCH_DIRS)
            if(EXISTS "${_dir}/${_needed}")
                file(REAL_PATH "${_dir}/${_needed}" _found_real)
                list(APPEND _matches "${_found_real}")
                set(_found "${_dir}/${_needed}")
            endif()
        endforeach()
        list(REMOVE_DUPLICATES _matches)
        list(LENGTH _matches _count)
        if(NOT _count EQUAL 1)
            message(FATAL_ERROR "Android dependency ${_needed} is missing or ambiguous")
        endif()
        list(APPEND _queue "${_found}")
    endforeach()
endwhile()
file(MAKE_DIRECTORY "${_staging}/apk-root/lib/${ANDROID_ABI}")
file(WRITE "${_staging}/.iisdkbuilder-package" "iiSDKBuilder Android unsigned APK\n")
set(_aapt_args link -I "${_jar}" --manifest "${MANIFEST}" -o "${_staging}/base.apk")
if(DEFINED ASSETS AND NOT ASSETS STREQUAL "")
    if(NOT IS_DIRECTORY "${ASSETS}")
        message(FATAL_ERROR "Android assets directory is missing")
    endif()
    list(APPEND _aapt_args -A "${ASSETS}")
endif()
if(DEFINED ANDROID_RES AND NOT ANDROID_RES STREQUAL "")
    if(NOT IS_DIRECTORY "${ANDROID_RES}")
        message(FATAL_ERROR "Android resource directory is missing")
    endif()
    execute_process(COMMAND "${_aapt}" compile --dir "${ANDROID_RES}" -o "${_staging}/compiled-res.zip"
        RESULT_VARIABLE _result ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Android resource compilation failed: ${_error}")
    endif()
    list(APPEND _aapt_args -R "${_staging}/compiled-res.zip" --auto-add-overlay)
endif()
execute_process(COMMAND "${_aapt}" ${_aapt_args} RESULT_VARIABLE _result ERROR_VARIABLE _error)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Android resource linking failed: ${_error}")
endif()
# Check the compiled manifest, not source text that may contain comments or
# alternate spellings. Android defaults hasCode to true when it is absent.
execute_process(COMMAND "${_aapt}" dump xmltree --file AndroidManifest.xml "${_staging}/base.apk"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _compiled_manifest ERROR_VARIABLE _error)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect compiled Android manifest: ${_error}")
endif()
if(NOT _compiled_manifest MATCHES "android:hasCode\\([^)]*\\)=false" AND
   (NOT DEFINED DEX OR DEX STREQUAL ""))
    message(FATAL_ERROR "Android manifest requires an explicitly supplied classes.dex")
endif()
file(ARCHIVE_EXTRACT INPUT "${_staging}/base.apk" DESTINATION "${_staging}/apk-root")
foreach(_library IN LISTS _libraries)
    file(COPY "${_library}" DESTINATION "${_staging}/apk-root/lib/${ANDROID_ABI}")
endforeach()
if(DEFINED DEX AND NOT DEX STREQUAL "")
    file(COPY_FILE "${DEX}" "${_staging}/apk-root/classes.dex")
endif()
file(GLOB _entries RELATIVE "${_staging}/apk-root" "${_staging}/apk-root/*")
# Native libraries must be stored, not deflated, for extractNativeLibs=false.
# Align .so entries to 16 KiB for devices with either 4 KiB or 16 KiB pages.
file(ARCHIVE_CREATE OUTPUT "${_staging}/unaligned.apk" PATHS ${_entries} FORMAT zip
    COMPRESSION None WORKING_DIRECTORY "${_staging}/apk-root")
execute_process(COMMAND "${_align}" -f -P 16 4 "${_staging}/unaligned.apk" "${_staging}/app-unsigned.apk"
    RESULT_VARIABLE _result ERROR_VARIABLE _error)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Android APK alignment failed: ${_error}")
endif()
file(REMOVE_RECURSE "${_staging}/apk-root")
file(REMOVE "${_staging}/base.apk" "${_staging}/unaligned.apk" "${_staging}/compiled-res.zip")
if(EXISTS "${DESTINATION}")
    file(RENAME "${DESTINATION}" "${_previous}" RESULT _result)
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "Cannot preserve previous Android package: ${_result}")
    endif()
endif()
file(RENAME "${_staging}" "${DESTINATION}" RESULT _result)
if(NOT _result STREQUAL "0")
    if(EXISTS "${_previous}")
        file(RENAME "${_previous}" "${DESTINATION}")
    endif()
    message(FATAL_ERROR "Cannot publish Android package: ${_result}")
endif()
if(EXISTS "${_previous}/.iisdkbuilder-package")
    file(REMOVE_RECURSE "${_previous}")
endif()
