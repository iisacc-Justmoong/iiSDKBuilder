if(NOT SOURCE_ROOT)
    message(FATAL_ERROR "SOURCE_ROOT is required")
endif()

file(READ "${SOURCE_ROOT}/LICENSE" _license)
if(NOT _license MATCHES "Apache License" OR NOT _license MATCHES "Version 2.0, January 2004")
    message(FATAL_ERROR "LICENSE is not the Apache License, Version 2.0")
endif()
if(NOT _license MATCHES "APPENDIX: How to apply the Apache License to your work")
    message(FATAL_ERROR "LICENSE is missing the Apache-2.0 appendix")
endif()
set(_mit_name "MIT")
set(_mit_grant "${_mit_name} License")
set(_mit_permission "Permission is hereby granted")
if(_license MATCHES "${_mit_grant}" OR _license MATCHES "${_mit_permission}")
    message(FATAL_ERROR "LICENSE still contains an MIT grant")
endif()

file(READ "${SOURCE_ROOT}/NOTICE" _notice)
if(NOT _notice MATCHES "Copyright \\(c\\) 2026 iisacc")
    message(FATAL_ERROR "NOTICE is missing Copyright (c) 2026 iisacc")
endif()

foreach(_rel IN ITEMS README.md AGENT.md docs/License.md)
    file(READ "${SOURCE_ROOT}/${_rel}" _text)
    if(NOT _text MATCHES "Apache License")
        message(FATAL_ERROR "${_rel} does not state the Apache License")
    endif()
    if(NOT _text MATCHES "Copyright \\(c\\) 2026 iisacc")
        message(FATAL_ERROR "${_rel} is missing Copyright (c) 2026 iisacc")
    endif()
endforeach()
foreach(_rel IN ITEMS README.md docs/License.md)
    file(READ "${SOURCE_ROOT}/${_rel}" _text)
    if(NOT _text MATCHES "SPDX-License-Identifier: Apache-2.0")
        message(FATAL_ERROR "${_rel} does not declare SPDX-License-Identifier: Apache-2.0")
    endif()
endforeach()

file(READ "${SOURCE_ROOT}/cmake/iiSDKBuilderConfig.cmake.in" _config)
file(READ "${SOURCE_ROOT}/CMakeLists.txt" _lists)
if(NOT _config MATCHES "set\\(iiSDKBuilder_SPDX_LICENSE \"Apache-2.0\"\\)"
        OR NOT _lists MATCHES "set\\(iiSDKBuilder_SPDX_LICENSE \"Apache-2.0\"\\)")
    message(FATAL_ERROR "CMake package metadata does not export iiSDKBuilder_SPDX_LICENSE")
endif()
if(NOT _lists MATCHES "install\\(FILES LICENSE NOTICE README\\.md")
    message(FATAL_ERROR "Install rules do not copy LICENSE")
endif()

set(_old_spdx "SPDX-License-Identifier:${_mit_name}")
string(REPLACE "${_mit_name}" " ${_mit_name}" _old_spdx "${_old_spdx}")
file(GLOB_RECURSE _files LIST_DIRECTORIES false "${SOURCE_ROOT}/*")
foreach(_file IN LISTS _files)
    if(_file MATCHES "/\\.git/|/build/")
        continue()
    endif()
    if(NOT _file MATCHES "\\.(md|h|hpp|cpp|py|cmake|txt|in)$" AND NOT _file MATCHES "/CMakeLists\\.txt$")
        continue()
    endif()
    file(READ "${_file}" _text)
    if(_text MATCHES "${_old_spdx}")
        message(FATAL_ERROR "First-party SPDX MIT claim remains in ${_file}")
    endif()
endforeach()
