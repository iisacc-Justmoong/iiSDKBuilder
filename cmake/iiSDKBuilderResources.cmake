include_guard(GLOBAL)

# This module runs a BUILD-HOST compiler; generated C++ is built by the target
# toolchain. Including it does not link Builder/FileProvider into applications.
function(iisdkbuilder_add_resources)
    cmake_parse_arguments(PARSE_ARGV 0 RES "" "TARGET;MANIFEST;COMPILER" "")
    if(RES_UNPARSED_ARGUMENTS OR RES_KEYWORDS_MISSING_VALUES OR
       NOT RES_TARGET OR NOT RES_MANIFEST OR NOT TARGET "${RES_TARGET}")
        message(FATAL_ERROR "iisdkbuilder_add_resources requires an existing TARGET and MANIFEST")
    endif()
    get_filename_component(_manifest "${RES_MANIFEST}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    file(READ "${_manifest}" _manifest_text)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_manifest}")
    string(JSON _name ERROR_VARIABLE _json_error GET "${_manifest_text}" name)
    string(LENGTH "${_name}" _name_length)
    if(_json_error OR NOT _name MATCHES "^[A-Za-z][A-Za-z0-9_]*$" OR
        _name MATCHES "__" OR _name_length GREATER 64)
        message(FATAL_ERROR "Resource manifest name must be a nonreserved ASCII identifier, at most 64 bytes")
    endif()
    get_target_property(_packs "${RES_TARGET}" IISDK_RESOURCE_PACKS)
    if(_name IN_LIST _packs)
        message(FATAL_ERROR "Resource pack ${_name} is already attached to ${RES_TARGET}")
    endif()
    set_property(TARGET "${RES_TARGET}" APPEND PROPERTY IISDK_RESOURCE_PACKS "${_name}")
    if(RES_COMPILER)
        set(_compiler "${RES_COMPILER}")
    elseif(IISDKBUILDER_RESOURCE_COMPILER)
        set(_compiler "${IISDKBUILDER_RESOURCE_COMPILER}")
    elseif(CMAKE_CROSSCOMPILING)
        message(FATAL_ERROR "Cross builds require IISDKBUILDER_RESOURCE_COMPILER pointing to a build-host iisdk-builder")
    elseif(TARGET iiSDKBuilderCLI)
        set(_compiler "$<TARGET_FILE:iiSDKBuilderCLI>")
    elseif(TARGET iiSDKBuilder::iiSDKBuilderCLI)
        set(_compiler "$<TARGET_FILE:iiSDKBuilder::iiSDKBuilderCLI>")
    else()
        find_program(_compiler NAMES iisdk-builder REQUIRED NO_CMAKE_FIND_ROOT_PATH)
    endif()
    if(EMSCRIPTEN)
        set(_platform wasm)
    elseif(ANDROID)
        set(_platform android)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "iOS")
        set(_platform ios)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        set(_platform macos)
    elseif(WIN32)
        set(_platform windows)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        set(_platform linux)
    else()
        message(FATAL_ERROR "Unsupported native resource target: ${CMAKE_SYSTEM_NAME}")
    endif()
    string(MAKE_C_IDENTIFIER "${RES_TARGET}" _target)
    set(_directory "${CMAKE_CURRENT_BINARY_DIR}/resources/${_target}_${_name}")
    set(_cpp "${_directory}/${_name}.cpp")
    set(_header "${_directory}/${_name}.h")
    set(_pack "${_directory}/${_name}.iirp")
    set(_depfile "${_directory}/${_name}.d")
    add_custom_command(OUTPUT "${_cpp}" "${_header}" "${_pack}"
        COMMAND "${_compiler}" resources --manifest "${_manifest}" --platform "${_platform}"
            --cpp "${_cpp}" --header "${_header}" --pack "${_pack}" --depfile "${_depfile}"
        DEPENDS "${_manifest}" "${_compiler}"
        DEPFILE "${_depfile}"
        VERBATIM COMMENT "Compiling native Core resources ${_name} for ${_platform}")
    target_sources("${RES_TARGET}" PRIVATE "${_cpp}")
    target_include_directories("${RES_TARGET}" PRIVATE "${_directory}")
    target_compile_features("${RES_TARGET}" PRIVATE cxx_std_23)
endfunction()
