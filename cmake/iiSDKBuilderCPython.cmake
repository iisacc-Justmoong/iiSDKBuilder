include_guard(GLOBAL)

function(iisdk_builder_cpython_aot)
    cmake_parse_arguments(AOT "" "TARGET;PYTHON_EXECUTABLE;NUITKA_LAUNCHER;OUTPUT_DIRECTORY" "SOURCES;DEPENDS;RUNTIME_TARGETS" ${ARGN})
    if(AOT_UNPARSED_ARGUMENTS OR NOT AOT_TARGET OR NOT AOT_PYTHON_EXECUTABLE OR NOT AOT_NUITKA_LAUNCHER
            OR NOT AOT_OUTPUT_DIRECTORY OR NOT AOT_SOURCES)
        message(FATAL_ERROR "CPython AOT requires TARGET, PYTHON_EXECUTABLE, NUITKA_LAUNCHER, OUTPUT_DIRECTORY and SOURCES")
    endif()
    if(CMAKE_CROSSCOMPILING)
        message(FATAL_ERROR "The Nuitka CPython AOT backend builds for the host; target cross compilation is not implemented")
    endif()
    get_filename_component(AOT_OUTPUT_DIRECTORY "${AOT_OUTPUT_DIRECTORY}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    execute_process(COMMAND "${AOT_PYTHON_EXECUTABLE}" -c
        "import platform, sys, sysconfig; print(sys.implementation.name); print(sysconfig.get_config_var('EXT_SUFFIX') or ''); print(platform.machine())"
        RESULT_VARIABLE _status OUTPUT_VARIABLE _info OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT _status EQUAL 0 OR NOT _info MATCHES "^cpython\n[^\n]+\n[^\n]+$")
        message(FATAL_ERROR "CPython AOT requires a CPython interpreter with an extension suffix")
    endif()
    string(REPLACE "\n" ";" _info_parts "${_info}")
    list(GET _info_parts 1 _suffix)
    list(GET _info_parts 2 _python_arch)
    if(TARGET iiSDKCore::CPython)
        get_target_property(_runtime_suffix iiSDKCore::CPython IISDK_CPYTHON_EXTENSION_SUFFIX)
        if(_runtime_suffix AND NOT _runtime_suffix STREQUAL _suffix)
            message(FATAL_ERROR "CPython ABI differs between the AOT interpreter and iiSDKCore::CPython")
        endif()
    endif()
    if(APPLE AND CMAKE_OSX_ARCHITECTURES)
        set(_target_arches ${CMAKE_OSX_ARCHITECTURES})
        list(LENGTH _target_arches _arch_count)
        list(GET _target_arches 0 _target_arch)
        string(TOLOWER "${_target_arch}" _target_arch)
        string(TOLOWER "${_python_arch}" _python_arch)
        if(_arch_count GREATER 1 OR NOT _target_arch STREQUAL _python_arch)
            message(FATAL_ERROR "CPython AOT requires the target architecture to match the selected host CPython")
        endif()
    endif()
    if(EXISTS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/Python/CompileAot.py")
        set(_backend "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/Python/CompileAot.py")
    else()
        set(_backend "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CompileAot.py")
    endif()
    if(NOT EXISTS "${_backend}")
        message(FATAL_ERROR "iiSDKBuilder CPython AOT backend is missing")
    endif()
    set(_outputs)
    set(_names)
    foreach(_source IN LISTS AOT_SOURCES)
        get_filename_component(_source "${_source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        get_filename_component(_name "${_source}" NAME_WE)
        if(_name IN_LIST _names)
            message(FATAL_ERROR "Duplicate CPython AOT module name: ${_name}")
        endif()
        list(APPEND _names "${_name}")
        set(_output "${AOT_OUTPUT_DIRECTORY}/${_name}${_suffix}")
        add_custom_command(OUTPUT "${_output}"
            COMMAND "${AOT_PYTHON_EXECUTABLE}" -B "${_backend}"
                --source "${_source}" --output "${_output}" --nuitka-launcher "${AOT_NUITKA_LAUNCHER}"
            DEPENDS "${_source}" "${_backend}" "${AOT_NUITKA_LAUNCHER}" ${AOT_DEPENDS}
            VERBATIM COMMENT "AOT compiling CPython module ${_name}")
        list(APPEND _outputs "${_output}")
    endforeach()
    add_custom_target("${AOT_TARGET}" DEPENDS ${_outputs})
    foreach(_runtime IN LISTS AOT_RUNTIME_TARGETS)
        if(NOT TARGET "${_runtime}")
            message(FATAL_ERROR "CPython AOT runtime target does not exist: ${_runtime}")
        endif()
        add_dependencies("${AOT_TARGET}" "${_runtime}")
        add_custom_command(TARGET "${AOT_TARGET}" POST_BUILD
            COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:${_runtime}>"
                "${AOT_OUTPUT_DIRECTORY}/$<TARGET_FILE_NAME:${_runtime}>" VERBATIM)
    endforeach()
    set_property(TARGET "${AOT_TARGET}" PROPERTY IISDK_CPYTHON_MODULE_DIRECTORY "${AOT_OUTPUT_DIRECTORY}")
    set_property(TARGET "${AOT_TARGET}" PROPERTY IISDK_CPYTHON_MODULES "${_outputs}")
endfunction()
