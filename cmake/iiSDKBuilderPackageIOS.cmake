cmake_minimum_required(VERSION 3.31)
if(NOT DEFINED INPUT OR NOT EXISTS "${INPUT}" OR NOT DEFINED DESTINATION OR
   NOT INPUT MATCHES "^(.*\\.app)/([^/]+)$")
    message(FATAL_ERROR "iOS packaging needs an executable inside an app bundle")
endif()
set(_app "${CMAKE_MATCH_1}")
set(_app_binary "${CMAKE_MATCH_2}")
get_filename_component(_app_name "${_app}" NAME)
if(NOT EXISTS "${_app}/Info.plist")
    message(FATAL_ERROR "iOS app bundle has no Info.plist")
endif()
find_program(_otool otool REQUIRED)
find_program(_install_name_tool install_name_tool REQUIRED)
find_program(_xcrun xcrun REQUIRED)
find_program(_lipo lipo REQUIRED)
function(_ios_binary_info image out_platform out_architectures)
    execute_process(COMMAND "${_xcrun}" vtool -show-build "${image}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _build ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Cannot inspect Apple platform for ${image}: ${_error}")
    endif()
    string(REGEX MATCHALL "platform (IOS|IOSSIMULATOR|MACOS|MACCATALYST)([ \n]|$)" _platforms "${_build}")
    list(REMOVE_DUPLICATES _platforms)
    list(LENGTH _platforms _count)
    if(NOT _count EQUAL 1 OR NOT _platforms MATCHES "^platform (IOS|IOSSIMULATOR)([ \n]|$)")
        message(FATAL_ERROR "Binary is not an iOS device or simulator image: ${image}")
    endif()
    string(REGEX REPLACE "^platform ([A-Z]+).*" "\\1" _platform "${_platforms}")
    execute_process(COMMAND "${_lipo}" -archs "${image}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _architectures ERROR_VARIABLE _error
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT _result EQUAL 0 OR _architectures STREQUAL "")
        message(FATAL_ERROR "Cannot inspect Apple architectures for ${image}: ${_error}")
    endif()
    separate_arguments(_architectures UNIX_COMMAND "${_architectures}")
    set(${out_platform} "${_platform}" PARENT_SCOPE)
    set(${out_architectures} "${_architectures}" PARENT_SCOPE)
endfunction()
_ios_binary_info("${INPUT}" _app_platform _app_architectures)
set(_staging "${DESTINATION}.staging")
set(_previous "${DESTINATION}.previous")
if(EXISTS "${_staging}" OR EXISTS "${_previous}")
    message(FATAL_ERROR "A previous package transaction needs inspection")
endif()
if(EXISTS "${DESTINATION}" AND NOT EXISTS "${DESTINATION}/.iisdkbuilder-package")
    message(FATAL_ERROR "Refusing to replace an unowned package")
endif()
list(APPEND SEARCH_DIRS "${_app}/Frameworks")
set(_queue "${INPUT}")
foreach(_module IN LISTS MODULE_NAMES)
    string(FIND "${_module}" "/" _slash)
    string(FIND "${_module}" "\\" _backslash)
    if(NOT _module MATCHES "^[A-Za-z0-9_.-]+\\.framework$" OR NOT _slash EQUAL -1 OR NOT _backslash EQUAL -1)
        message(FATAL_ERROR "An iOS runtime module must be a framework name: ${_module}")
    endif()
    string(REGEX REPLACE "\\.framework$" "" _binary "${_module}")
    set(_found_paths)
    foreach(_dir IN LISTS SEARCH_DIRS)
        if(EXISTS "${_dir}/${_module}/${_binary}")
            file(REAL_PATH "${_dir}/${_module}/${_binary}" _real)
            list(APPEND _found_paths "${_real}")
            set(_found "${_dir}/${_module}/${_binary}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _found_paths)
    list(LENGTH _found_paths _count)
    if(NOT _count EQUAL 1)
        message(FATAL_ERROR "iOS framework ${_module} is missing or ambiguous")
    endif()
    list(APPEND _queue "${_found}")
endforeach()
set(_seen)
set(_framework_names)
set(_framework_paths)
while(_queue)
    list(POP_FRONT _queue _image)
    file(REAL_PATH "${_image}" _real)
    if(_real IN_LIST _seen)
        continue()
    endif()
    list(APPEND _seen "${_real}")
    if(NOT _image STREQUAL INPUT)
        _ios_binary_info("${_image}" _platform _architectures)
        if(NOT _platform STREQUAL _app_platform)
            message(FATAL_ERROR "iOS framework targets ${_platform}, app targets ${_app_platform}: ${_image}")
        endif()
        foreach(_arch IN LISTS _app_architectures)
            if(NOT _arch IN_LIST _architectures)
                message(FATAL_ERROR "iOS framework lacks app architecture ${_arch}: ${_image}")
            endif()
        endforeach()
        if(NOT _image MATCHES "^(.*\\.framework)/([^/]+)$")
            message(FATAL_ERROR "iOS third-party dynamic code must be a framework: ${_image}")
        endif()
        set(_framework "${CMAKE_MATCH_1}")
        set(_binary "${CMAKE_MATCH_2}")
        get_filename_component(_framework_name "${_framework}" NAME)
        string(REGEX REPLACE "\\.framework$" "" _expected "${_framework_name}")
        if(NOT _binary STREQUAL _expected OR NOT EXISTS "${_framework}/Info.plist")
            message(FATAL_ERROR "Invalid iOS framework structure: ${_framework}")
        endif()
        if(_framework_name IN_LIST _framework_names)
            message(FATAL_ERROR "iOS framework name collision: ${_framework_name}")
        endif()
        list(APPEND _framework_names "${_framework_name}")
        list(APPEND _framework_paths "${_framework}")
    endif()
    execute_process(COMMAND "${_otool}" -L "${_image}" RESULT_VARIABLE _result
        OUTPUT_VARIABLE _deps ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Cannot inspect iOS binary ${_image}: ${_error}")
    endif()
    string(REPLACE "\n" ";" _lines "${_deps}")
    foreach(_line IN LISTS _lines)
        string(STRIP "${_line}" _line)
        if(NOT _line MATCHES "^(.+) \\(compatibility version ")
            continue()
        endif()
        set(_old "${CMAKE_MATCH_1}")
        if(_old MATCHES "^(/usr/lib/|/System/Library/)")
            continue()
        endif()
        if(NOT _old MATCHES "([^/]+\\.framework)/([^/]+)$")
            message(FATAL_ERROR "Unsupported iOS dynamic dependency outside a framework: ${_old}")
        endif()
        set(_dep_framework "${CMAKE_MATCH_1}")
        set(_dep_binary "${CMAKE_MATCH_2}")
        if(NOT _image STREQUAL INPUT AND _dep_framework STREQUAL _framework_name AND _dep_binary STREQUAL _binary)
            continue()
        endif()
        set(_matches)
        if(_old MATCHES "^@rpath/")
            foreach(_dir IN LISTS SEARCH_DIRS)
                if(EXISTS "${_dir}/${_dep_framework}/${_dep_binary}")
                    file(REAL_PATH "${_dir}/${_dep_framework}/${_dep_binary}" _match_real)
                    list(APPEND _matches "${_match_real}")
                    set(_match "${_dir}/${_dep_framework}/${_dep_binary}")
                endif()
            endforeach()
        else()
            get_filename_component(_loader_dir "${_image}" DIRECTORY)
            get_filename_component(_exe_dir "${INPUT}" DIRECTORY)
            string(REPLACE "@loader_path" "${_loader_dir}" _candidate "${_old}")
            string(REPLACE "@executable_path" "${_exe_dir}" _candidate "${_candidate}")
            if(EXISTS "${_candidate}")
                file(REAL_PATH "${_candidate}" _match_real)
                list(APPEND _matches "${_match_real}")
                set(_match "${_candidate}")
            endif()
        endif()
        list(REMOVE_DUPLICATES _matches)
        list(LENGTH _matches _count)
        if(NOT _count EQUAL 1)
            message(FATAL_ERROR "iOS dependency ${_old} is missing or ambiguous")
        endif()
        list(APPEND _queue "${_match}")
    endforeach()
endwhile()
file(MAKE_DIRECTORY "${_staging}")
file(WRITE "${_staging}/.iisdkbuilder-package" "iiSDKBuilder unsigned iOS application\n")
file(COPY "${_app}" DESTINATION "${_staging}")
set(_output_app "${_staging}/${_app_name}")
file(REMOVE_RECURSE "${_output_app}/Frameworks" "${_output_app}/_CodeSignature")
file(MAKE_DIRECTORY "${_output_app}/Frameworks")
foreach(_framework IN LISTS _framework_paths)
    file(COPY "${_framework}" DESTINATION "${_output_app}/Frameworks")
endforeach()
set(_images "${_output_app}/${_app_binary}")
foreach(_framework_name IN LISTS _framework_names)
    string(REGEX REPLACE "\\.framework$" "" _binary "${_framework_name}")
    set(_framework "${_output_app}/Frameworks/${_framework_name}")
    file(REMOVE_RECURSE "${_framework}/_CodeSignature")
    list(APPEND _images "${_framework}/${_binary}")
endforeach()
foreach(_image IN LISTS _images)
    execute_process(COMMAND "${_otool}" -L "${_image}" RESULT_VARIABLE _result OUTPUT_VARIABLE _deps)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Cannot inspect copied iOS image")
    endif()
    if(_image STREQUAL "${_output_app}/${_app_binary}")
        set(_relative "@executable_path/Frameworks")
        set(_own_framework "")
    else()
        set(_relative "@loader_path/..")
        get_filename_component(_own_binary "${_image}" NAME)
        get_filename_component(_own_dir "${_image}" DIRECTORY)
        get_filename_component(_own_framework "${_own_dir}" NAME)
        execute_process(COMMAND "${_install_name_tool}" -id "@rpath/${_own_framework}/${_own_binary}" "${_image}" RESULT_VARIABLE _result)
        if(NOT _result EQUAL 0)
            message(FATAL_ERROR "Cannot relocate iOS framework identity")
        endif()
    endif()
    string(REPLACE "\n" ";" _lines "${_deps}")
    list(REMOVE_DUPLICATES _lines)
    foreach(_line IN LISTS _lines)
        string(STRIP "${_line}" _line)
        if(NOT _line MATCHES "^(.+) \\(compatibility version ")
            continue()
        endif()
        set(_old "${CMAKE_MATCH_1}")
        if(_old MATCHES "^(/usr/lib/|/System/Library/)")
            continue()
        endif()
        if(NOT _old MATCHES "([^/]+\\.framework)/([^/]+)$")
            message(FATAL_ERROR "Unsupported copied iOS dependency: ${_old}")
        endif()
        set(_dep_framework "${CMAKE_MATCH_1}")
        set(_dep_binary "${CMAKE_MATCH_2}")
        if(_dep_framework STREQUAL _own_framework)
            continue()
        endif()
        if(NOT _dep_framework IN_LIST _framework_names)
            message(FATAL_ERROR "iOS framework was not packaged: ${_old}")
        endif()
        set(_new "${_relative}/${_dep_framework}/${_dep_binary}")
        if(NOT _old STREQUAL _new)
            execute_process(COMMAND "${_install_name_tool}" -change "${_old}" "${_new}" "${_image}" RESULT_VARIABLE _result)
            if(NOT _result EQUAL 0)
                message(FATAL_ERROR "Cannot relocate iOS framework dependency: ${_old}")
            endif()
        endif()
    endforeach()
    # The copied image must be signed again with the app's distribution identity.
    execute_process(COMMAND codesign --remove-signature "${_image}" OUTPUT_QUIET ERROR_QUIET)
endforeach()
if(EXISTS "${DESTINATION}")
    file(RENAME "${DESTINATION}" "${_previous}" RESULT _result)
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "Cannot preserve previous iOS package: ${_result}")
    endif()
endif()
file(RENAME "${_staging}" "${DESTINATION}" RESULT _result)
if(NOT _result STREQUAL "0")
    if(EXISTS "${_previous}")
        file(RENAME "${_previous}" "${DESTINATION}")
    endif()
    message(FATAL_ERROR "Cannot publish iOS package: ${_result}")
endif()
if(EXISTS "${_previous}/.iisdkbuilder-package")
    file(REMOVE_RECURSE "${_previous}")
endif()
