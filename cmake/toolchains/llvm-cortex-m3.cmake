set(CMAKE_SYSTEM_NAME Generic)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES IISDK_EMBEDDED_LLD)
set(CMAKE_SYSTEM_PROCESSOR armv7-m)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT CMAKE_CXX_COMPILER)
    find_program(CMAKE_CXX_COMPILER NAMES clang++ REQUIRED)
endif()
find_program(IISDK_EMBEDDED_LLD NAMES ld.lld REQUIRED)
set(CMAKE_CXX_COMPILER_TARGET arm-none-eabi)
set(CMAKE_CXX_FLAGS_INIT "-mcpu=cortex-m3 -mthumb -ffreestanding -fno-exceptions -fno-rtti -fno-threadsafe-statics -fno-use-cxa-atexit -ffunction-sections -fdata-sections")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-nostdlib -fuse-ld=${IISDK_EMBEDDED_LLD} -Wl,--gc-sections")
